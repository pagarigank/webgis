<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    cacheDirectory=".phpunit.cache"
    colors="true"
    failOnRisky="true"
    failOnWarning="true"
    beStrictAboutTestsThatDoNotTestAnything="false">
    <testsuites>
        <testsuite name="webgis-backend">
            <!--
                List every test subdirectory explicitly. A single recursive
                "<directory suffix=\"Test.php\">tests</directory>" entry silently
                collects only a fraction of tests/Api (45 of 48 classes were
                skipped), so the suite reported green while never running them.
            -->
            <directory suffix="Test.php">tests/Api</directory>
            <directory suffix="Test.php">tests/Integration</directory>
            <directory suffix="Test.php">tests/Spatial</directory>
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
