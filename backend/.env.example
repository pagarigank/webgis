# Application
APP_ENV=local
APP_DEBUG=true

# Database (PostgreSQL/PostGIS)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=webgis
DB_USER=app_rw
DB_PASS=change_me_in_production

# Authentication / JWT
JWT_SECRET=generate_a_secure_random_string_for_production
REFRESH_TOKEN_DOMAIN=localhost

# MFA secret encryption: base64 of 32 random bytes
# Generate with: php -r echo base64_encode random_bytes 32
# Keep this value stable: rotating it makes enrolled secrets unreadable.
MFA_ENCRYPTION_KEY="replace_with_base64_of_32_random_bytes"

# Basemap Proxies (Optional)
# BASEMAP_BING_KEY=
# BASEMAP_MAPBOX_KEY=
